QWidget {
    background-color: rgb(240, 242, 245);
    color: rgb(30, 30, 40);
    font-size: 13px;
}

QPushButton {
    background-color: white;
    color: rgb(30, 30, 40);
    border: 1px solid gray;
    border-radius: 8px;
    padding: 4px;
}

QPushButton:hover {
    background-color: rgb(225, 235, 250);
}

QPushButton:checked {
    background-color: rgb(230, 100, 100);
    color: white;
    font-weight: bold;
}

QDoubleSpinBox, QComboBox {
    background-color: white;
    color: rgb(30, 30, 40);
    border: 1px solid gray;
    border-radius: 4px;
    padding: 2px;
}
/* ===== Warm Hanukkah theme ===== */

QWidget {
    background-color: rgb(38, 22, 14);
    color: rgb(255, 215, 130);
    font-family: "Segoe UI";
    font-size: 13px;
}

QLabel {
    background: transparent;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(255, 225, 140), stop:1 rgb(215, 150, 45));
    color: rgb(60, 30, 10);
    border: 1px solid rgb(255, 235, 170);
    border-radius: 10px;
    padding: 4px;
    font-weight: bold;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(255, 240, 180), stop:1 rgb(240, 175, 60));
}

QPushButton:pressed {
    background: rgb(200, 130, 40);
}

QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(255, 150, 60), stop:1 rgb(200, 50, 20));
    color: rgb(255, 245, 220);
    border: 1px solid rgb(255, 190, 120);
}

QDoubleSpinBox, QComboBox {
    background-color: rgb(255, 243, 220);
    color: rgb(50, 25, 10);
    border: 1px solid rgb(215, 150, 45);
    border-radius: 5px;
    padding: 2px;
}

QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: rgb(120, 95, 75);
    color: rgb(230, 210, 180);
}

QComboBox QAbstractItemView {
    background-color: rgb(255, 243, 220);
    color: rgb(50, 25, 10);
    selection-background-color: rgb(255, 180, 70);
    selection-color: rgb(50, 25, 10);
}